NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys. Publishable (sb_publishable_...) is safe in
# the browser; secret (sb_secret_...) is server-only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Browser key: Maps JavaScript API only, restricted to your site's domains
# (and http://localhost:3000 for dev).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional; falls back to Google's DEMO_MAP_ID, which is fine for dev.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server key: Street View Static API only (used for free metadata lookups
# when picking locations). Never exposed to the browser.
GOOGLE_MAPS_SERVER_KEY=
